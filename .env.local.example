# Copy this file to .env.local for local development.
# Get these values from your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Set to "false" to hide magic-link sign-in and use name-only quick join.
NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=true

# Only needed for the schema/migration scripts (npm run db:schema / db:migrate).
# Supabase → Project Settings → Database → Connection string. Never commit this.
# SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Alternative to the line above: the password alone. The scripts then build a
# direct connection from NEXT_PUBLIC_SUPABASE_URL, which needs IPv6 — prefer the
# pooler string when that fails. `npm run db:check` needs neither; it reads the
# schema over the public REST API.
# SUPABASE_DB_PASSWORD=your-database-password
